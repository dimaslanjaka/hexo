{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "moduleResolution": "Node",
    "strict": false,
    "rootDir": "lib",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "tmp/dist",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "mocha"]
  },
  "include": ["lib/**/*.ts"],
  "exclude": ["node_modules"]
}
