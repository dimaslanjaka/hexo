{
  "terminal.integrated.env.linux": {
    "DEBUG_PKG": "1",
    "ESLINT_USE_FLAT_CONFIG": "true",
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/usr/lib/wsl/lib:${workspaceFolder}/bin:${workspaceFolder}/node_modules/.bin:${workspaceFolder}/vendor/bin",
    "PHP_CS_FIXER_IGNORE_ENV": "1"
  },
  "terminal.integrated.env.windows": {
    "DEBUG_PKG": "1",
    "ESLINT_USE_FLAT_CONFIG": "true",
    "PATH": "${env:LOCALAPPDATA}\\nvm;C:\\nvm4w\\nodejs;C:\\Program Files\\Git\\cmd;C:\\Program Files\\Git\\usr\\bin;${env:PATH};${workspaceFolder}\\node_modules\\.bin;${workspaceFolder}\\bin;${workspaceFolder}\\vendor\\bin",
    "PHP_CS_FIXER_IGNORE_ENV": "1"
  },
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "never"
  },
  "eslint.lintTask.enable": true,
  "npm.packageManager": "yarn",
  "code-runner.respectShebang": true,
  "code-runner.executorMapByGlob": {
    "*.{test,spec}.{ts,js}": "npx c8 --reporter=lcovonly mocha --timeout=7000000",
    "*.build.js": "yarn build && node -r ts-node/register"
  },
  "code-runner.clearPreviousOutput": true,
  "code-runner.runInTerminal": true,
  "workbench.localHistory.exclude": {
    "**/dist/**": true
  },
  "files.exclude": {
    "**/node_modules": true
  },
  "search.exclude": {
    "**/dist": true,
    "**/node_modules": true
  },
  "git.autoRepositoryDetection": "openEditors",
  "git.autofetch": false,
  "git.autorefresh": true,
  "git.autoStash": true,
  "git.branchSortOrder": "committerdate",
  "git.defaultBranchName": "master",
  "git.detectSubmodules": false,
  "git.detectSubmodulesLimit": 20,
  "git.diagnosticsCommitHook.enabled": true,
  "git.enabled": true,
  "git.ignoreLimitWarning": true,
  "git.ignoredRepositories": ["packages/hexo-cli/assets", "packages/hexo-theme-landscape"],
  "git.mergeEditor": true,
  "git.promptToSaveFilesBeforeCommit": "always",
  "git.promptToSaveFilesBeforeStash": "always",
  "git.rememberPostCommitCommand": true,
  "git.repositoryScanIgnoredFolders": ["node_modules", "dist", "tmp/"],
  "git.repositoryScanMaxDepth": 6,
  "git.supportCancellation": true,
  "git.verboseCommit": false,
  "eslint.useFlatConfig": true,
  "git.allowNoVerifyCommit": true,
  "git.confirmNoVerifyCommit": true
}
