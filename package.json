{
  "name": "hexo",
  "version": "8.1.1",
  "description": "A fast, simple & powerful blog framework, powered by Node.js.",
  "main": "dist/cjs/hexo/index.js",
  "module": "dist/esm/hexo/index.js",
  "types": "./dist/esm/hexo/index.d.ts",
  "bin": "./bin/hexo",
  "scripts": {
    "build": "npm run build-cjs && npm run build-esm && npm run build-tsc && npm run build-exports",
    "build-cjs": "tsc -p tsconfig.cjs.json",
    "build-dts": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "build-esm": "tsc -p tsconfig.esm.json",
    "build-exports": "node scripts/build_exports.mjs",
    "build-rollup": "npm run build-to-tmp && rollup -c -m",
    "build-tsc": "tsc -b --outDir dist --declaration --noEmit false",
    "build-tsup": "node build.mjs",
    "build-to-tmp": "tsc --outDir tmp/dist",
    "clean": "npx -y rimraf build-debug.log dist build.log",
    "eslint": "eslint lib test",
    "prepare": "husky",
    "prepublishOnly": "npm install && npm run clean && npm run build",
    "test": "mocha test/scripts/**/*.ts --require ts-node/register",
    "test-cov": "c8 --reporter=lcovonly npm test -- --no-parallel",
    "test2": "mocha --node-option loader=ts-node/esm --node-option experimental-specifier-resolution=node test/scripts/**/*.ts",
    "watch": "npx -y nodemon --delay 5 --watch \"build*.*js\" --watch lib --ext js,ts --exec \"yarn build > build.log 2>&1 && yarn workspace hexo-site exec \\\"hexo generate --verbose --debug\\\"\""
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexojs/hexo.git"
  },
  "homepage": "https://hexo.io/",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/hexo"
  },
  "keywords": [
    "website",
    "blog",
    "cms",
    "framework",
    "hexo"
  ],
  "author": "Tommy Chen <tommy351@gmail.com> (https://zespia.tw)",
  "maintainers": [
    "Abner Chou <hi@abnerchou.me> (https://abnerchou.me)"
  ],
  "license": "MIT",
  "dependencies": {
    "abbrev": "^3.0.0",
    "bluebird": "^3.7.2",
    "fast-archy": "^1.0.0",
    "fast-text-table": "^1.0.1",
    "hexo-cli": "^4.3.2",
    "hexo-front-matter": "^4.2.1",
    "hexo-fs": "^5.0.0",
    "hexo-i18n": "^2.0.0",
