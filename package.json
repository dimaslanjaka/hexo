{
  "name": "hexo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Hexo Monorepo",
  "main": "packages/hexo/dist/hexo/index.js",
  "types": "packages/hexo/dist/hexo/index.d.ts",
  "author": {
    "name": "Dimas Lanjaka",
    "email": "dimaslanjaka@gmail.com",
    "url": "https://www.webmanajemen.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimaslanjaka/hexo.git"
  },
  "homepage": "https://github.com/dimaslanjaka/hexo#readme",
  "bugs": {
    "url": "https://github.com/dimaslanjaka/hexo/issues"
  },
  "keywords": [
    "hexo",
    "monorepo"
  ],
  "scripts": {
    "build": "nrs \"build:**\" && node -r ts-node/register build.ts",
    "build-commit": "nrs \"build:**\" && node -r ts-node/register build.ts --commit",
    "build:fm": "yarn workspace hexo-front-matter run build",
    "build:log": "yarn workspace hexo-log run build",
    "build:util": "yarn workspace hexo-util run build",
    "build:packages": "yarn workspaces foreach --worktree --no-private run build",
    "clean": "node -r ts-node/register build.ts --clean",
    "lint": "eslint --fix",
    "prepare": "husky && node submodule-handler.js && yarn workspaces foreach --all run prepare",
    "prestart": "npm run build",
    "pretest": "npm run build",
    "site:build": "yarn workspace hexo-site run build",
    "site:clean": "yarn workspace hexo-site run clean",
    "site:serve": "yarn workspace hexo-site run start",
    "start": "yarn run site:serve",
    "test": "yarn workspace foreach --no-private exec \"npm run test --if-present\"",
    "update:ncu": "npx npm-check-updates -u && yarn workspaces foreach --no-private --worktree run update:ncu"
  },
  "dependencies": {
    "fs-extra": "^11.3.0",
    "git-command-helper": "^2.1.0",
    "minimist": "^1.2.8",
    "nunjucks": "^3.2.4",
    "picocolors": "^1.1.1",
    "sbg-utility": "^2.0.8",
    "upath": "^2.0.1"
  },
  "devDependencies": {
    "@types/eslint": "^9",
    "@types/fs-extra": "^11.0.4",
    "@types/minimist": "^1",
    "@types/node": "^24.1.0",
    "@types/nunjucks": "^3.2.6",
    "@types/prettier": "^3",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "binary-collections": "^2.0.9",
    "cross-spawn": "^7.0.6",
    "depcheck": "^1.4.7",
    "dotenv": "^17.2.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "mocha": "^11.7.1",
    "npm-check-updates": "^18.0.2",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=14"
  },
  "packageManager": "yarn@4.9.2",
  "resolutions": {
    "@types/node": "^20",
    "binary-collections": "https://github.com/dimaslanjaka/bin/raw/26bd53205081195770fe9b7b83d94f1531caccf0/releases/bin.tgz",
    "cross-spawn": "https://github.com/dimaslanjaka/node-cross-spawn/raw/80999ac7a7031a81e11ddb5fab0f8ba433041c98/release/cross-spawn.tgz",
    "git-command-helper": "https://github.com/dimaslanjaka/git-command-helper/raw/100b6294c7b7fd879d87be7a550758bc2f6ff0e1/release/git-command-helper.tgz",
    "hexo": "workspace:^",
    "hexo-asset-link": "workspace:^",
    "hexo-cli": "workspace:^",
    "hexo-front-matter": "workspace:^",
    "hexo-is": "workspace:^",
    "hexo-log": "workspace:^",
    "hexo-util": "workspace:^",
    "sbg-utility": "https://github.com/dimaslanjaka/static-blog-generator/raw/df939d4cb3e31fded39412534bcef11de9fe0dcc/packages/sbg-utility/release/sbg-utility.tgz",
    "warehouse": "workspace:^"
  },
  "workspaces": [
    "packages/*",
    "test/hexo-theme-test"
  ]
}
