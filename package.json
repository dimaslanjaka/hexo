{
  "name": "hexo",
  "version": "8.1.2",
  "description": "A fast, simple & powerful blog framework, powered by Node.js.",
  "main": "./dist/cjs/hexo/index.js",
  "module": "./dist/esm/hexo/index.js",
  "types": "./dist/esm/hexo/index.d.ts",
  "bin": "./bin/hexo",
  "scripts": {
    "build": "tsup && npm run build-tsc && npm run build-exports && node scripts/replace-version.mjs && cp package.json dist/package.json",
    "build-exports": "node scripts/build-package-exports.mjs",
    "build-tsc": "tsc -p tsconfig.build.json --outDir dist/esm --emitDeclarationOnly --declaration --noEmit false",
    "clean": "npx -y rimraf build-debug.log dist tmp/dist build.log",
    "eslint": "eslint lib test",
    "prepare": "husky",
    "prepublishOnly": "npm install && npm run clean && npm run build",
    "test": "mocha --require ts-node/register --require ./scripts/resolve-ts-v3.cjs --timeout 60000",
    "test-all": "npm test -- test/scripts/**/*.ts",
    "test-cov": "c8 --reporter=lcovonly npm run test-all -- --no-parallel",
    "test-esm": "node --import=tsx --import=./scripts/resolve-ts-v3.cjs ./node_modules/mocha/bin/mocha.js test/scripts/**/*.ts",
    "test2": "node -r ts-node/register --import=./scripts/resolve-ts.cjs ./node_modules/mocha/bin/mocha.js test/scripts/**/*.ts",
    "watch": "npx -y nodemon --delay 5 --watch \"build*.*js\" --watch lib --ext js,ts --exec \"yarn build > build.log 2>&1 && yarn workspace hexo-site exec \\\"hexo generate --verbose --debug\\\"\"",
    "pack": "npx -y tarball-packer --yarn --filename hexo --normalize-resolutions"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexojs/hexo.git"
  },
  "homepage": "https://hexo.io/",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/hexo"
  },
  "keywords": [
    "website",
    "blog",
    "cms",
    "framework",
    "hexo"
  ],
  "author": "Tommy Chen <tommy351@gmail.com> (https://zespia.tw)",
  "maintainers": [
    "Abner Chou <hi@abnerchou.me> (https://abnerchou.me)"
  ],
  "license": "MIT",
  "resolutions": {
    "got": "11.8.2"
  },
  "dependencies": {
    "abbrev": "^5.0.0",
    "bluebird": "^3.7.2",
    "fast-archy": "^1.0.0",
    "fast-text-table": "^1.0.1",
    "glob": "^13.0.6",
    "hexo-cli": "^4.3.2",
    "hexo-front-matter": "^4.2.1",
    "hexo-fs": "^5.0.0",
    "hexo-i18n": "^2.0.0",
    "hexo-log": "^4.1.0",
    "hexo-util": "https://github.com/dimaslanjaka/hexo-util/raw/378f4df/release/hexo-util.tgz",
    "js-yaml": "^4.1.0",
    "js-yaml-js-types": "^1.0.1",
    "micromatch": "^4.0.8",
    "moize": "^6.1.6",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.2",
    "nunjucks": "^3.2.4",
    "picocolors": "^1.1.1",
    "pretty-hrtime": "^1.0.3",
    "strip-ansi": "^7.1.0",
    "titlecase": "^1.1.3",
    "warehouse": "https://github.com/dimaslanjaka/warehouse/raw/20c740d/release/warehouse.tgz"
  },
  "devDependencies": {
    "0x": "^6.0.0",
    "@types/abbrev": "^1.1.3",
    "@types/bluebird": "^3.5.37",
    "@types/chai": "^4.3.11",
    "@types/connect": "^3.4.38",
    "@types/graceful-fs": "^4.1.9",
    "@types/js-yaml": "^4.0.9",
    "@types/micromatch": "^4.0.7",
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.17.6",
    "@types/nunjucks": "^3.2.2",
    "@types/pretty-hrtime": "^1.0.3",
    "@types/sinon": "^17.0.3",
    "binary-collections": "^2.0.15",
    "c8": "^9.0.0",
    "chai": "^4.3.6",
    "cheerio": "1.0.0",
    "decache": "^4.6.1",
    "eslint": "^9.17.0",
    "eslint-config-hexo": "^6.0.0",
    "hexo-renderer-marked": "^6.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "mocha": "^10.0.0",
    "sinon": "^17.0.1",
    "ts-node": "^10.9.1",
    "tsup": "^9.0.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
