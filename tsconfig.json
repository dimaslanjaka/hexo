{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "target": "es2020",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "dist",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "mocha"]
  },
  "include": ["lib/**/*.ts"],
  "exclude": ["node_modules"]
}
