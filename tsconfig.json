{
  "ts-node": {
    "experimentalResolver": true
  },
  "compilerOptions": {
    "module": "es2022",
    "moduleResolution": "bundler",
    "target": "es2020",
    "sourceMap": true,
    "outDir": "tmp/dist",
    "rootDir": ".",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": false,
    "noImplicitAny": false,
    "types": [
      "node",
      "mocha"
    ]
  },
  "include": [
    "lib/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
