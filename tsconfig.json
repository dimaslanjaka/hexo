{
  // This is the TypeScript configuration file for the Hexo project.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "sourceMap": true,
    "outDir": "dist",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha"]
  },
  "exclude": ["node_modules", "**/.tmp*", "dist"]
}
