{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "sourceMap": true,
    "outDir": "dist",
    "declaration": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "types": [
      "node",
      "mocha"
    ]
  },
  "include": [
    "lib/**/*.ts",
    "test/**/*.ts",
    "test/**/*.cjs",
    "test/**/*.mjs",
    "test/**/*.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
